[Unit]
Description=Thrifty-X fastdet detector (C capture+detect via fastdet.sh)
Documentation=https://github.com/Denny-Hwang/thrifty-x
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
# Rate-limit restarts (these keys live in [Unit]; systemd ignores them
# under [Service]).
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
ExecStart=/home/pi/thrifty-x/rpi/fastdet.sh
WorkingDirectory=/home/pi/thrifty-x
User=pi
Group=pi
Type=simple

# Restart on transient failure (USB enumeration, brief stream stalls).
Restart=on-failure
RestartSec=120

# Hardening — adapted from thriftyx-capture@.service.  Unlike that
# unit (which writes under /var/lib/thriftyx), fastdet.sh works in
# /home/pi/detector, so ProtectHome would make the unit kill itself:
# instead /home stays accessible and only the system dirs are
# read-only.  NoNewPrivileges is safe because fastdet.sh performs no
# sudo (clock stepping is ntp-after-online.service's job).
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/home/pi/detector
PrivateTmp=true

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=thriftyx-detector

[Install]
WantedBy=multi-user.target
