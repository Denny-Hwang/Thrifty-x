# Thrifty-X capture configuration — Raspberry Pi 5 (Airspy Mini/R2)
# Place at /var/lib/thriftyx/capture.cfg and edit per receiver.
# Format: key: value  (hash = comment; k/M/G suffixes allowed, see
# docs/user_guide.md 5.1).  carrier_window is in FFT bins unless it ends
# in Hz: 50-60kHz is a frequency, 50-60k is bins 50000-60000.

# --- Receiver identity ---
# Not used by capture (a .card does not record it): `thriftyx detect -c`
# with this file stamps it into the detections.  Unique per receiver,
# the id of its line in pos-rx.cfg.
rxid:               0

# --- Hardware selection ---
# device_type:      airspy_mini   (or airspy_r2)
device_type:        airspy_mini
# airspy_serial:    0xABCDEF0123456789      # optional, when multiple devices

# --- RF / sampling ---
tuner_freq:         433.83M
# Mini: 3M or 6M ; R2: 2.5M or 10M.  6M is the Mini default, the rate of
# example/detector_mini.cfg.  Every receiver must capture at the same
# rate, and the server must use it: `thriftyx tdoa -s <this rate>` (or
# sample_rate in the server's detector.cfg).  A different rate there
# scales every TDOA and puts the positions far off, with no error.
sample_rate:        6M
chip_rate:          0.999707M

# --- Block layout ---
# Leave block_size / block_history unset: the defaults follow the sample
# rate and hold the template of any supported code (up to 11 bits).  A
# pinned overlap that is too short makes every card uncorrelatable with
# longer codes -- capture and the config validator warn about it.
# block_size:       32768       # 6M default; 16384 at 3M
# block_history:    12349       # 6M default; 6206 at 3M
capture_skip:       100

# --- Carrier detection ---
# FFT bins of 183.1 Hz with the default blocks at 6M (and at 3M).
carrier_window:     7 - 110
carrier_threshold:  14 * snr

# --- Gain (defaults from PR #19 — avoids ADC saturation) ---
gain_mode:          manual
lna_gain:           7
mixer_gain:         7
vga_gain:           7
lna_agc:            false
mixer_agc:          false

# --- Other Airspy options (PR #22, #23) ---
bias_tee:           false
ppm:                0.0          # site-specific; measure per node
packing:            true         # 12-bit USB packing — recommended for 6M/10M
