# /etc/default/thriftyx-cleanup
# Read by /usr/local/bin/cleanup_old_captures.sh (hourly cron job).
#
# THRIFTYX_OUT must match THRIFTYX_OUT in /etc/default/thriftyx-capture@<rxid>,
# or the job cleans a directory the capture service does not write to.

THRIFTYX_OUT=/var/lib/thriftyx

# Retention, in days since last modification.
CARD_RETENTION_DAYS=7
TOAD_RETENTION_DAYS=30
LOG_RETENTION_DAYS=30

# Disk usage (percent): log a warning at DISK_WARN_PCT; at DISK_PURGE_PCT
# delete the oldest .card files until usage is below DISK_WARN_PCT.
DISK_WARN_PCT=80
DISK_PURGE_PCT=90
