# /etc/default/thriftyx-capture@<rxid>
# Copy to /etc/default/thriftyx-capture@rx0 (etc.) and edit.
#
# NOTE: the service's User= and WorkingDirectory= are literal values in
# the unit file (systemd does not expand variables there).  If you change
# the user or clone path, also override those two lines via
# `sudo systemctl edit thriftyx-capture@<rxid>`.

THRIFTYX_HOME=/home/pi/thrifty-x
THRIFTYX_CONFIG=/var/lib/thriftyx/capture.cfg
# If you move THRIFTYX_OUT off /var/lib/thriftyx, also update
# RequiresMountsFor= in the unit (systemctl edit).
THRIFTYX_OUT=/var/lib/thriftyx

# Seconds per card file (new file on wall-clock boundaries; default 3600).
# THRIFTYX_ROTATE_S=3600

# Headless matplotlib (analysis tools called from same env)
MPLBACKEND=Agg
