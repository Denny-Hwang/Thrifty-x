[Unit]
Description=Thrifty-X capture service for receiver %i
Documentation=https://github.com/Denny-Hwang/thrifty-x
# TDOA needs receiver clocks in sync before the first timestamp is
# written.  chrony-wait.service (shipped with Debian's chrony) blocks
# until chronyd reports a synchronised clock, up to its start timeout;
# ordering after it keeps capture from stamping cards with an unsynced
# clock at boot (the Pi 5 RTC has no battery by default).  Wants=, not
# Requires=: if sync cannot be reached in time, capture still starts and
# chronyd keeps correcting, rather than the node never recording.
After=network-online.target time-sync.target chrony-wait.service
Wants=network-online.target time-sync.target chrony-wait.service
# Do not start while the data disk is missing: with a `nofail` fstab
# entry for the USB SSD, capture would otherwise fill the SD card's
# /var/lib/thriftyx.  (Harmless when /var/lib/thriftyx is not a separate
# mount.)  Match THRIFTYX_OUT if you moved it.
RequiresMountsFor=/var/lib/thriftyx
# No start rate limit: an unattended node must keep retrying through a
# USB brown-out or a slow Airspy enumeration.  (With the old limit of 10
# starts in 300 s, about 100 s of trouble stopped the unit for good
# until someone ran `systemctl reset-failed`.)  This key lives in [Unit].
StartLimitIntervalSec=0

[Service]
Type=simple
# Start a new card file every hour (on the hour on every node) so the
# cleanup job can expire old data while capture keeps running; block
# indices continue across files.  Override in the env file.
Environment=THRIFTYX_ROTATE_S=3600
EnvironmentFile=/etc/default/thriftyx-capture@%i
# systemd does NOT expand environment variables in User= or
# WorkingDirectory= — they must be literal values (a ${VAR} here is a
# fatal unit error and the service never starts).  Edit these two lines
# (e.g. sudo systemctl edit thriftyx-capture@rx0) if your deployment
# does not use the stock `pi` user / clone path.
User=pi
Group=plugdev
WorkingDirectory=/home/pi/thrifty-x

# Activate the project venv and run capture.
# THRIFTYX_OUT should point to a USB SSD path, NOT the SD card.
# The output name is a strftime pattern (%% is systemd's escape for %):
# capture names each file by its start time, e.g. rx0_20260101T130000.card.
ExecStart=/bin/bash -lc '\
    source "${THRIFTYX_HOME}/.venv/bin/activate" && \
    exec thriftyx capture "${THRIFTYX_OUT}/card/%i_%%Y%%m%%dT%%H%%M%%S.card" \
        --rotate "${THRIFTYX_ROTATE_S}" \
        --config "${THRIFTYX_CONFIG}" \
    '

# Restart whenever capture exits, including a clean exit (e.g. the
# device vanished and read_sync ended the stream).  `systemctl stop`
# still stops it.
Restart=always
RestartSec=10
# ...except for a configuration error (exit 78, EX_CONFIG): retrying
# cannot fix it, and restarting every 10 s would bury the one error
# line in the journal.  The unit shows `failed` until someone fixes
# capture.cfg and runs `systemctl restart`.
RestartPreventExitStatus=78

# Hardening — relax if blocking your setup.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ProtectHome=read-only

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=thriftyx-capture-%i

[Install]
WantedBy=multi-user.target
